# Public site URL used for canonical tags, Open Graph and the sitemap.
# [TO BE CONFIRMED BY CLIENT] — replace with the live domain.
SITE_URL=https://www.lovistotours.co.za

# Quote form endpoint. Use either a Formspree URL
# (https://formspree.io/f/xxxxxxx) or a Web3Forms endpoint
# (https://api.web3forms.com/submit). Leave blank to fall back to email.
PUBLIC_FORM_ENDPOINT=

# Only needed for Web3Forms, which requires an access key.
PUBLIC_FORM_ACCESS_KEY=
