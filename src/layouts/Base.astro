---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = '/og-default.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.lovistotours.co.za').href;
const ogImage = new URL(image, Astro.site ?? 'https://www.lovistotours.co.za').href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | ${site.short}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${canonical}#organization`,
      name: site.name,
      legalName: site.name,
      alternateName: site.short,
      url: Astro.site?.href,
      foundingDate: String(site.established),
      slogan: site.tagline,
      description,
    },
    {
      '@type': ['LocalBusiness', 'TravelAgency'],
      '@id': `${canonical}#business`,
      name: site.name,
      url: Astro.site?.href,
      telephone: site.phone,
      email: site.email,
      foundingDate: String(site.established),
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        addressCountry: 'ZA',
        postalCode: '2745',
      },
      areaServed: ['Mahikeng', 'North West', 'South Africa'],
      isRetail: false,
    },
  ],
};
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f3efe6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-sun focus:px-4 focus:py-2 focus:font-semibold focus:text-ink">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <WhatsAppButton />
    <script>
      // Scroll reveals and route-line drawing.
      const animated = document.querySelectorAll<HTMLElement>('.reveal, .draw');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        animated.forEach((el) => observer.observe(el));
      } else {
        animated.forEach((el) => el.classList.add('is-in'));
      }

      // Small, optional parallax on marked images only.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const parallax = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (!reduced && parallax.length) {
        let queued = false;
        window.addEventListener('scroll', () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            const shift = Math.min(window.scrollY, 900) * 0.08;
            parallax.forEach((el) => {
              el.style.transform = `translate3d(0, ${shift}px, 0) scale(1.12)`;
            });
            queued = false;
          });
        }, { passive: true });
      }
    </script>
  </body>
</html>
