---
import { Image } from 'astro:assets';
import { imageByFile } from '../data/images';

// An optimised <Image> when the file exists; otherwise a clearly labelled slot.
// No stock photography is used anywhere on the site.
const all = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

interface Props {
  name: string;
  alt?: string;
  hint?: string;
  sizes?: string;
  class?: string;
  imgClass?: string;
  priority?: boolean;
  widths?: number[];
  position?: string;
}

const {
  name,
  alt,
  hint,
  sizes = '100vw',
  class: cls = '',
  imgClass = '',
  priority = false,
  widths,
  position,
} = Astro.props;

const definition = imageByFile[name];
const finalAlt = alt ?? definition?.alt ?? 'Photograph from a Lovisto Tours trip';
const finalHint = hint ?? definition?.hint;
const found = all[`/src/assets/images/${name}`]?.default;

const maxWidth = found ? Math.min(found.width * 2, 1600) : 1600;
const requested = widths ?? [480, 800, 1200, 1800];
const generatedWidths = requested.filter((width) => width <= maxWidth);
const imageWidths = generatedWidths.length ? generatedWidths : found ? [found.width] : requested;
---
<div class:list={['relative overflow-hidden bg-paper-2', cls]}>
  {found ? (
    <Image
      src={found}
      alt={finalAlt}
      widths={imageWidths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      class:list={['h-full w-full object-cover', imgClass]}
      style={position ? `object-position: ${position}` : undefined}
    />
  ) : (
    <div
      class="slot-empty absolute inset-0 flex flex-col justify-end p-4 text-ink"
      role="img"
      aria-label={`Photo to come: ${finalAlt}`}
    >
      <p class="label text-ink/65">Photo slot</p>
      <p class="mt-1 font-mono text-xs break-all">{name}</p>
      {finalHint && <p class="mt-2 max-w-[42ch] text-xs text-ink/70">Supply: {finalHint}</p>}
    </div>
  )}
</div>
