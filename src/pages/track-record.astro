---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { events, years, clientTypes } from '../data/events';

const grouped = years.map((year) => ({
  year,
  items: events.filter((event) => event.year === year),
}));
const ongoing = events.filter((event) => event.ongoing);
---
<Base
  title="Track record | Tours and transport since 2016"
  description="Browse Lovisto Tours' events from 2016 to 2025: government transport, school excursions, church groups, teambuilding, hotel shuttles and international delegations from Mahikeng."
>
  <PageHero
    label="Our track record"
    title="Where we have been, 2016 to 2025."
    intro="A list of previous successful events: scheduled tours, provincial government work, school trips, hotel shuttles, church groups and delegations."
    image="track-record-group.jpg"
    imageAlt="A Lovisto Tours group at a cliff viewpoint"
    caption="Group tour, North West · company profile"
    imageClass="aspect-[3/2] max-w-[30rem] lg:aspect-[4/5] lg:max-w-none"
  />

  <section class="border-b border-line bg-paper-2/60" aria-labelledby="ongoing-h">
    <div class="wrap py-8">
      <h2 id="ongoing-h" class="label text-ink/65">Ongoing services</h2>
      <ul class="mt-4 grid gap-5 md:grid-cols-2">
        {ongoing.map((event) => (
          <li class="border-l border-sun pl-4">
            <p class="text-sm font-semibold text-ink">{event.when}</p>
            <p class="mt-1 text-sm text-ink/65">{event.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap py-14 md:py-20" aria-labelledby="timeline-h">
    <h2 id="timeline-h" class="sr-only">Filterable event timeline</h2>

    <div class="reveal grid gap-5 border-y border-line py-5 sm:grid-cols-2 md:grid-cols-[1fr_1fr_auto] md:items-end">
      <div>
        <label class="field-label" for="year-filter">Filter by year</label>
        <select id="year-filter" class="field">
          <option value="">All years</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </div>
      <div>
        <label class="field-label" for="type-filter">Filter by client type</label>
        <select id="type-filter" class="field">
          <option value="">All client types</option>
          {clientTypes.map((type) => <option value={type}>{type}</option>)}
        </select>
      </div>
      <button id="reset-filters" type="button" class="btn btn-line">Reset</button>
    </div>

    <p id="result-count" class="mt-4 text-xs font-semibold tracking-[0.12em] text-ink/65 uppercase" role="status" aria-live="polite">
      Showing all {events.length} events.
    </p>

    <div id="timeline" class="mt-8">
      {grouped.map((group) => (
        <section class="grid gap-5 border-t border-line py-10 md:grid-cols-[8rem_1fr] md:gap-12" data-year-group={group.year}>
          <div>
            <p class="font-display text-3xl font-semibold tracking-[-0.04em] md:text-4xl">{group.year}</p>
            <p class="mt-1 text-[0.65rem] font-semibold tracking-[0.14em] text-ink/65 uppercase">
              {group.items.length} {group.items.length === 1 ? 'entry' : 'entries'}
            </p>
          </div>
          <ol>
            {group.items.map((event) => (
              <li class="grid gap-1 border-b border-line py-4 first:pt-0 sm:grid-cols-[10rem_1fr] sm:gap-6" data-event data-type={event.type} data-year={event.year}>
                <p class="text-xs font-semibold text-forest">{event.when}</p>
                <div>
                  <p class="text-sm text-ink/75">{event.text}</p>
                  <p class="mt-1 text-[0.62rem] font-semibold tracking-[0.12em] text-ink/65 uppercase">
                    {event.type}{event.ongoing ? ' · ongoing' : ''}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
    <p id="no-results" class="border-l-2 border-sun pl-4 text-sm text-ink/70" hidden>
      No events match those filters. Try another year or client type.
    </p>
  </section>

  <section class="border-t border-line" aria-labelledby="track-cta-h">
    <div class="wrap grid gap-6 py-14 md:grid-cols-[1fr_auto] md:items-center md:py-16">
      <div>
        <h2 id="track-cta-h" class="text-3xl md:text-4xl">Plan the next trip with us.</h2>
        <p class="mt-3 text-ink/65">Based in Mahikeng, able to render services anywhere.</p>
      </div>
      <a href="/contact" class="btn btn-dark">Plan a trip</a>
    </div>
  </section>
</Base>

<script>
  const yearFilter = document.getElementById('year-filter') as HTMLSelectElement | null;
  const typeFilter = document.getElementById('type-filter') as HTMLSelectElement | null;
  const resetButton = document.getElementById('reset-filters') as HTMLButtonElement | null;
  const count = document.getElementById('result-count');
  const empty = document.getElementById('no-results');
  const events = Array.from(document.querySelectorAll<HTMLElement>('[data-event]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-year-group]'));

  const apply = () => {
    const year = yearFilter?.value ?? '';
    const type = typeFilter?.value ?? '';
    let visible = 0;
    events.forEach((event) => {
      const show = (!year || event.dataset.year === year) && (!type || event.dataset.type === type);
      event.hidden = !show;
      if (show) visible += 1;
    });
    groups.forEach((group) => {
      const hasVisible = Array.from(group.querySelectorAll<HTMLElement>('[data-event]')).some((event) => !event.hidden);
      group.hidden = !hasVisible;
    });
    if (count) count.textContent = `Showing ${visible} of ${events.length} events.`;
    if (empty) empty.hidden = visible !== 0;
  };

  yearFilter?.addEventListener('change', apply);
  typeFilter?.addEventListener('change', apply);
  resetButton?.addEventListener('click', () => {
    if (yearFilter) yearFilter.value = '';
    if (typeFilter) typeFilter.value = '';
    apply();
  });
</script>
