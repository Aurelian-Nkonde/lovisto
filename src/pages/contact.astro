---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import PageHero from '../components/PageHero.astro';
import { site, waLink } from '../data/site';
---
<Base
  title="Contact and request a quote | Lovisto Tours, Mahikeng"
  description="Request a quote from Lovisto Tours in Mahikeng, North West. Send your date, passenger count, pick-up and drop-off, or contact us by phone, email or WhatsApp."
>
  <PageHero
    label="Contact"
    title="Tell us where the group is going."
    intro="Send the travel date(s), number of passengers, pick-up and drop-off. Based in Mahikeng, able to render services anywhere."
    image="fleet-passenger-van.jpg"
    imageAlt="A Lovisto Tours passenger van and trailer on an open road"
    caption="On the road, North West · company profile"
  />

  <section class="wrap grid gap-12 py-14 lg:grid-cols-[1.35fr_0.65fr] lg:gap-16 lg:py-20" aria-labelledby="form-h">
    <div>
      <p class="label text-ink/65">Request a quote</p>
      <h2 id="form-h" class="mt-3 text-3xl md:text-4xl">A few details to start.</h2>
      <p class="mt-3 max-w-[48ch] text-sm text-ink/70">
        Fields marked with an asterisk are required. If the online form is unavailable, call us or use WhatsApp.
      </p>
      <div class="mt-8"><ContactForm /></div>
    </div>

    <aside class="self-start" aria-label="Other ways to reach us">
      <div class="border-t border-line">
        <div class="border-b border-line py-5">
          <p class="label text-ink/65">Cell and WhatsApp</p>
          <a class="mt-1 inline-block font-display text-2xl font-semibold tracking-[-0.04em] hover:text-forest" href={waLink()}>{site.phone}</a>
          <p class="mt-2 text-sm text-ink/70">Prefer a message? The WhatsApp button fills in your request details.</p>
        </div>
        <div class="border-b border-line py-5">
          <p class="label text-ink/65">Office</p>
          <a class="mt-1 block text-lg hover:text-forest" href={site.telHref}>{site.tel}</a>
        </div>
        <div class="border-b border-line py-5">
          <p class="label text-ink/65">Email</p>
          <a class="mt-1 block break-all text-lg hover:text-forest" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="border-b border-line py-5">
          <p class="label text-ink/65">Address</p>
          <address class="mt-1 text-sm text-ink/65 not-italic">
            {site.address.street}<br />
            {site.address.city}, {site.address.region}<br />
            {site.address.country}<br />
            {site.address.postal}
          </address>
        </div>
        <div class="py-5">
          <p class="label text-ink/65">Where we operate</p>
          <p class="mt-1 text-sm text-ink/70">
            Based in Mahikeng, the capital of North West Province, and able to render services anywhere. Our track record includes Mafikeng Game Reserve, Botsalano Game Reserve, Gaborone and Zambia via Zimbabwe and Botswana.
          </p>
        </div>
      </div>
    </aside>
  </section>

  <section class="wrap pb-20" aria-labelledby="map-h">
    <div class="border-t border-line pt-8">
      <p class="label text-ink/65">Find us</p>
      <h2 id="map-h" class="mt-3 text-3xl md:text-4xl">Mahikeng, North West.</h2>
      <p class="mt-3 text-ink/70">Stand no 12041, Lomanyaneng Village, Mahikeng, North West.</p>
      <div class="mt-6"><MapEmbed /></div>
    </div>
  </section>
</Base>
