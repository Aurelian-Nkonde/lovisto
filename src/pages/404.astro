---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { waLink } from '../data/site';
---
<Base
  title="Page not found"
  description="That page could not be found. Return to Lovisto Tours in Mahikeng, or request a quote."
  noindex
>
  <section class="border-b border-line" aria-labelledby="not-found-h">
    <div class="wrap grid items-stretch gap-0 lg:grid-cols-12">
      <div class="flex flex-col justify-center py-16 pr-0 lg:col-span-6 lg:py-24 lg:pr-16">
        <p class="label flex items-center gap-3 text-ink/65">
          <span class="h-px w-8 bg-ink/40"></span>
          Off the route
        </p>
        <p aria-hidden="true" class="mt-8 font-display text-[clamp(6rem,14vw,12rem)] leading-[0.8] font-semibold tracking-[-0.06em] text-forest">
          404.
        </p>
        <h1 id="not-found-h" class="mt-6 max-w-[14ch] text-[clamp(2.25rem,4.4vw,4rem)]">
          This page is not on our map.
        </h1>
        <p class="mt-6 max-w-[46ch] text-lg text-ink/70">
          The address may have changed. Start again from the home page, or tell us what you were looking for.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/contact" class="btn btn-line">Request a quote</a>
          <a href={waLink()} class="btn btn-line">WhatsApp us</a>
        </div>
      </div>

      <div class="relative min-h-[22rem] lg:col-span-6 lg:min-h-[34rem]">
        <ImageSlot
          name="gallery-06.jpg"
          alt="A Lovisto Tours van travelling through a mountain pass"
          class="absolute inset-0 h-full"
          sizes="(min-width: 1024px) 50vw, 100vw"
          widths={[640, 960, 1280]}
          position="center"
        />
        <p class="absolute bottom-4 left-4 bg-paper px-3 py-1.5 text-xs font-semibold">Somewhere on the long road</p>
      </div>
    </div>
  </section>

  <section class="wrap flex flex-wrap items-baseline justify-between gap-4 py-8 text-sm">
    <p class="text-ink/65">Try one of these instead:</p>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 font-medium" aria-label="Helpful links">
      <a class="hover:text-forest" href="/services">Services</a>
      <a class="hover:text-forest" href="/fleet">Fleet</a>
      <a class="hover:text-forest" href="/track-record">Track record</a>
      <a class="hover:text-forest" href="/about">About</a>
      <a class="hover:text-forest" href="/procurement">Procurement</a>
      <a class="hover:text-forest" href="/contact">Contact</a>
    </nav>
  </section>
</Base>
