---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, credentials } from '../data/site';
import { company } from '../data/company';
---
<Base
  title="Procurement | Company profile and compliance details"
  description="Compliance details for government and corporate buyers: Lovisto Tours registration 2014/089906/07, CSD MAAA0007621, BBBEE Level 1, NPTR accreditation ACC25060001194 and Mahikeng address."
>
  <PageHero
    label="For buyers"
    title="Procurement and compliance."
    intro="Company details for tender and supplier records. Lovisto Tours is based in Mahikeng, North West, and is able to render services anywhere."
    meta={[
      { label: 'Registration', value: company.registration },
      { label: 'CSD number', value: 'MAAAA0007621' },
      { label: 'NPTR', value: 'ACC25060001194' },
    ]}
  />

  <section class="wrap section-pad" aria-labelledby="details-h">
    <h2 id="details-h" class="sr-only">Company compliance details</h2>
    <div class="grid gap-10 lg:grid-cols-[1.35fr_0.65fr] lg:gap-16">
      <div>
        <dl class="border-t border-line">
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Legal company name</dt>
            <dd class="text-sm text-ink/70">{site.name}</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Company registration number</dt>
            <dd class="text-sm text-ink/70">{company.registration}</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Central Supplier Database number</dt>
            <dd class="text-sm text-ink/70">MAAAA0007621</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">BBBEE status</dt>
            <dd class="text-sm text-ink/70">Level 1 · {company.ownership}</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">NPTR accreditation</dt>
            <dd class="text-sm text-ink/70">Certificate of accreditation as a tourist transport operator · ACC25060001194 · valid to 18 June 2030</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Memberships</dt>
            <dd class="text-sm text-ink/70">Tourism Association of Mahikeng (TAMAH) · Small Tourism Enterprise Association</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Physical address</dt>
            <dd class="text-sm text-ink/70">{site.address.street}, {site.address.city}, {site.address.region}, {site.address.country}</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Postal address</dt>
            <dd class="text-sm text-ink/70">{site.address.postal}</dd>
          </div>
          <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
            <dt class="text-sm font-semibold">Contact</dt>
            <dd class="text-sm text-ink/70">
              <a class="inline-block py-1 hover:text-forest" href={site.phoneHref}>{site.phone}</a> (cell and WhatsApp)<br />
              <a class="inline-block py-1 hover:text-forest" href={site.telHref}>{site.tel}</a> (office)<br />
              <a class="inline-block py-1 hover:text-forest" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
      </div>

      <aside class="self-start border border-line bg-paper-2/70 p-6" aria-labelledby="download-h">
        <p class="label text-ink/65">Company profile</p>
        <h2 id="download-h" class="mt-3 text-2xl">Download company profile (PDF)</h2>
        <p class="mt-4 text-sm text-ink/70">
          The linked file is a placeholder. Replace <code class="font-mono text-xs">public/documents/lovisto-company-profile.pdf</code> with the official company profile before launch.
        </p>
        <a href="/documents/lovisto-company-profile.pdf" class="btn btn-dark mt-6 w-full" download>Download company profile (PDF)</a>
        <hr class="my-7 border-line" />
        <p class="label text-ink/65">Credentials at a glance</p>
        <ul class="mt-4 space-y-3 text-sm">
          {credentials.map((credential) => (
            <li class="border-l border-sun pl-3">
              <span class="block font-semibold">{credential.label}</span>
              <span class="mt-0.5 block text-ink/70">{credential.detail}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="proc-cta-h">
    <div class="wrap grid gap-6 py-14 md:grid-cols-[1fr_auto] md:items-center md:py-16">
      <div>
        <h2 id="proc-cta-h" class="text-3xl md:text-4xl">Request service information or a quote.</h2>
        <p class="mt-3 text-ink/65">Send the trip type, date and passenger count. We reply using the details you provide.</p>
      </div>
      <a href="/contact" class="btn btn-dark">Contact us</a>
    </div>
  </section>
</Base>
