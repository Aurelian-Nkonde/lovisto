---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PageHero from '../components/PageHero.astro';
import { serviceGroups, packagesNote } from '../data/services';
import { waLink, site } from '../data/site';
---
<Base
  title="Services | Coach hire, shuttles and tours from Mahikeng"
  description="All Lovisto Tours services: charter transport, shuttles, transfers, luxury and semi-luxury coach hire, leisure, eco, safari, cultural and tailor-made tours, teambuilding and travel management."
>
  <PageHero
    label="What we do"
    title="Transport, tours and the work around them."
    intro="We coordinate comprehensive travel itineraries, wholesale and retail our packages, and arrange vehicles, drivers and bookings for groups."
    image="services-tours.jpg"
    imageAlt="A group at a green rock pool on a Lovisto Tours trip"
    caption="Rock pool, North West · company profile"
  >
    <p class="mt-8 max-w-[36ch] text-sm text-ink/65">{packagesNote}</p>
  </PageHero>

  <div class="wrap grid gap-10 py-14 lg:grid-cols-[15rem_1fr] lg:gap-16 lg:py-20">
    <aside class="lg:sticky lg:top-28 lg:self-start">
      <p class="label text-ink/65">Service groups</p>
      <nav class="mt-4" aria-label="Service groups">
        <ul class="border-t border-line">
          {serviceGroups.map((group) => (
            <li class="border-b border-line">
              <a href={`#${group.id}`} class="flex items-baseline justify-between gap-4 py-3 text-sm font-semibold text-ink/70 hover:text-ink">
                <span>{group.title}</span>
                <span class="text-xs font-normal text-ink/65">{group.number}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href="/contact" class="btn btn-dark mt-6 w-full">Plan a trip</a>
    </aside>

    <div>
      {serviceGroups.map((group, index) => (
        <section class:list={['grid gap-8 border-t border-line pt-10 pb-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12', index === 0 && 'border-t-0 pt-0']} id={group.id} aria-labelledby={`${group.id}-h`}>
          <div class="image-frame self-start">
            <ImageSlot
              name={group.image}
              class="aspect-[4/3]"
              sizes="(min-width: 1024px) 36vw, 100vw"
              widths={[480, 800, 1200]}
            />
          </div>

          <div>
            <p class="label text-ink/65">{group.number} / {String(serviceGroups.length).padStart(2, '0')}</p>
            <h2 id={`${group.id}-h`} class="mt-3">{group.title}</h2>
            <p class="mt-5 max-w-[48ch] text-lg text-ink/70">{group.blurb}</p>

            <dl class="mt-8 border-t border-line">
              {group.items.map((item) => (
                <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] sm:gap-6">
                  <dt class="text-sm font-semibold text-ink">{item.name}</dt>
                  <dd class="text-sm text-ink/70">{item.detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      ))}
    </div>
  </div>

  <section class="bg-forest text-paper" aria-labelledby="services-cta-h">
    <div class="wrap grid gap-10 py-16 md:grid-cols-[1.2fr_1fr] md:py-20">
      <div>
        <p class="label text-sun">Start here</p>
        <h2 id="services-cta-h" class="mt-4 max-w-[12ch] text-paper!">Tell us what the group needs.</h2>
        <p class="mt-5 max-w-[42ch] text-paper/70">Date, passengers, pick-up and drop-off are enough to start. Based in Mahikeng, able to render services anywhere.</p>
        <a href="/contact" class="btn btn-primary mt-8">Plan a trip</a>
      </div>
      <ul class="grid gap-5 self-end border-t border-paper/20 pt-6 sm:grid-cols-2">
        <li>
          <span class="label text-paper/65">Cell and WhatsApp</span>
          <a class="mt-1 block hover:text-sun" href={waLink()}>{site.phone}</a>
        </li>
        <li>
          <span class="label text-paper/65">Office</span>
          <a class="mt-1 block hover:text-sun" href={site.telHref}>{site.tel}</a>
        </li>
      </ul>
    </div>
  </section>
</Base>
