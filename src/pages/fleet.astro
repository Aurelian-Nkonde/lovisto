---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PageHero from '../components/PageHero.astro';
import { fleet, TBC } from '../data/fleet';
---
<Base
  title="Fleet | Luxury coaches, vans and game-drive vehicle in Mahikeng"
  description="See the vehicle types used by Lovisto Tours: luxury coach, semi-luxury coach, passenger vans and a game-drive vehicle for Mafikeng and Botsalano game reserves."
>
  <PageHero
    label="Fleet"
    title="Coaches, vans and an open vehicle."
    intro="The vehicle types shown in the company profile. Shuttles, transfers, school runs, long-distance coach trips and game drives at Mafikeng Game Reserve and Botsalano Game Reserve."
    image="hero-coach-convoy.jpg"
    imageAlt="Lovisto Tours coaches and a passenger van lined up in Mahikeng"
    caption="Fleet line-up, Mahikeng · company profile"
  />

  <section class="wrap section-pad" aria-label="Vehicle types">
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
      {fleet.map((vehicle) => (
        <article class="group flex h-full flex-col">
          <div class="image-frame">
            <ImageSlot
              name={vehicle.image}
              class="aspect-[4/3]"
              sizes="(min-width: 768px) 46vw, 100vw"
              widths={[480, 800, 1200]}
            />
          </div>
          <div class="mt-5 border-t border-line pt-4">
            <p class="label text-ink/65">{vehicle.name}</p>
            <h2 class="mt-2 text-3xl md:text-4xl">{vehicle.name}</h2>
            <p class="mt-3 max-w-[44ch] text-ink/65">{vehicle.blurb}</p>
            <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
              <dt class="text-ink/65">Capacity</dt>
              <dd class="text-ink/80">{vehicle.capacity}</dd>
              <dt class="text-ink/65">Specifications</dt>
              <dd class="text-ink/80">{vehicle.specs}</dd>
            </dl>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-16 max-w-[70ch] border-l-2 border-sun pl-4 text-sm text-ink/70">
      {TBC} — capacities, makes, models and on-board specifications are not stated in the company profile. Ask us for the exact vehicle for your trip.
    </p>
  </section>

  <section class="border-t border-line" aria-labelledby="fleet-cta-h">
    <div class="wrap grid gap-6 py-14 md:grid-cols-[1fr_auto] md:items-center md:py-16">
      <div>
        <h2 id="fleet-cta-h" class="text-3xl md:text-4xl">Not sure which vehicle fits?</h2>
        <p class="mt-3 text-ink/65">Send the passenger count and route. We will match the vehicle and send a quote.</p>
      </div>
      <a href="/contact" class="btn btn-dark">Plan a trip</a>
    </div>
  </section>
</Base>
